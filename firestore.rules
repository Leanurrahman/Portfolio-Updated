rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // 2. Profile Rules
    match /profile/{profileId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 3. Projects Rules
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 4. Skills Rules
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 5. Services Rules
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 6. Testimonials Rules
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 7. Contact Messages Rules (Supports both /messages and /contactMessages)
    match /messages/{messageId} {
      allow read, update, delete: if isSignedIn();
      allow create: if true
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 150
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000;
    }

    match /contactMessages/{messageId} {
      allow read, update, delete: if isSignedIn();
      allow create: if true
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 150
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000;
    }

    // 8. Site Settings Rules (Supports both /settings and /siteSettings)
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /siteSettings/{settingsId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 9. Chat Conversations Rules
    match /chatConversations/{conversationId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow delete: if isSignedIn();
      allow create: if true
        && request.resource.data.visitorName is string && request.resource.data.visitorName.size() > 0 && request.resource.data.visitorName.size() <= 100
        && request.resource.data.visitorEmail is string && request.resource.data.visitorEmail.size() > 0 && request.resource.data.visitorEmail.size() <= 150;
      allow update: if isSignedIn() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageSender', 'lastMessageAt', 'updatedAt',
          'unreadByAdmin', 'unreadByVisitor', 'status', 'adminOnline', 'visitorTyping'
        ])
      );

      // Subcollection messages
      match /messages/{messageId} {
        allow read: if true;
        allow delete: if isSignedIn();
        allow create: if (
          (isSignedIn() && request.resource.data.sender in ["admin", "system", "admin_auto"]) ||
          (!isSignedIn() && request.resource.data.sender in ["visitor", "system", "admin_auto"])
        )
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000;
        allow update: if isSignedIn() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    // 10. Site Presence Rules
    match /sitePresence/{presenceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 11. Experience Settings Rules
    match /experienceSettings/{settingsId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
