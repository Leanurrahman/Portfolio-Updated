{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Developer profile information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "title": { "type": "string" },
        "tagline": { "type": "string" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "profileImage": { "type": "string" },
        "heroImage": { "type": "string" },
        "cvUrl": { "type": "string" },
        "availabilityStatus": { "type": "string", "enum": ["available", "busy", "looking-for-offers"] },
        "socialLinks": { "type": "object" },
        "education": { "type": "object" }
      },
      "required": ["name", "role", "title", "tagline", "bio", "location", "email", "profileImage", "availabilityStatus"]
    },
    "Project": {
      "title": "Project",
      "description": "Portfolio project item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "shortDescription": { "type": "string" },
        "longDescription": { "type": "string" },
        "techStack": { "type": "array" },
        "category": { "type": "string" },
        "thumbnail": { "type": "string" },
        "liveLink": { "type": "string" },
        "githubLink": { "type": "string" },
        "featured": { "type": "boolean" },
        "client": { "type": "string" },
        "year": { "type": "string" },
        "problemSolved": { "type": "string" },
        "keyFeatures": { "type": "array" },
        "results": { "type": "string" },
        "gallery": { "type": "array" },
        "order": { "type": "number" }
      },
      "required": ["id", "title", "shortDescription", "longDescription", "techStack", "category", "thumbnail", "order"]
    },
    "Skill": {
      "title": "Skill",
      "description": "Professional or programming skill",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Frontend", "Backend", "Tools", "Programming"] },
        "proficiency": { "type": "number" },
        "icon": { "type": "string" }
      },
      "required": ["id", "name", "category"]
    },
    "Service": {
      "title": "Service",
      "description": "Offered development service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "active": { "type": "boolean" },
        "ctaText": { "type": "string" }
      },
      "required": ["id", "title", "description", "icon", "active"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Client feedback and testimonial",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "clientRole": { "type": "string" },
        "clientCompany": { "type": "string" },
        "message": { "type": "string" },
        "rating": { "type": "number" },
        "clientImage": { "type": "string" }
      },
      "required": ["id", "clientName", "clientRole", "clientCompany", "message", "rating"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Contact message submitted by public visitors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "company": { "type": "string" },
        "projectType": { "type": "string" },
        "budgetRange": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["unread", "read", "replied"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "projectType", "budgetRange", "message", "status", "createdAt"]
    },
    "ChatConversation": {
      "title": "ChatConversation",
      "description": "A real-time chat conversation between visitor and admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "visitorName": { "type": "string" },
        "visitorEmail": { "type": "string" },
        "projectType": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "unreadByAdmin": { "type": "number" },
        "unreadByVisitor": { "type": "number" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "object" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["id", "visitorName", "visitorEmail", "status", "unreadByAdmin", "unreadByVisitor", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single message inside a chat conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string", "enum": ["visitor", "admin"] },
        "text": { "type": "string" },
        "createdAt": { "type": "object" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "sender", "text", "createdAt", "read"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Website custom appearance settings",
      "type": "object",
      "properties": {
        "logoText": { "type": "string" },
        "themeColor": { "type": "string" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "ogImage": { "type": "string" },
        "footerText": { "type": "string" },
        "contactEmail": { "type": "string" },
        "maintenanceMode": { "type": "boolean" }
      },
      "required": ["logoText", "themeColor", "seoTitle", "seoDescription", "footerText", "contactEmail", "maintenanceMode"]
    }
  },
  "firestore": {
    "/profile": { "schema": "Profile", "description": "Single-document profile store at /profile/main" },
    "/projects": { "schema": "Project", "description": "Collection of developer projects" },
    "/skills": { "schema": "Skill", "description": "Collection of developer skills" },
    "/services": { "schema": "Service", "description": "Collection of services provided" },
    "/testimonials": { "schema": "Testimonial", "description": "Collection of client testimonials" },
    "/messages": { "schema": "ContactMessage", "description": "Collection of client inquiries" },
    "/settings": { "schema": "SiteSettings", "description": "Single-document system settings at /settings/main" },
    "/chatConversations": { "schema": "ChatConversation", "description": "Collection of live chat conversations" },
    "/chatConversations/{conversationId}/messages": { "schema": "ChatMessage", "description": "Collection of messages inside a conversation" }
  }
}
